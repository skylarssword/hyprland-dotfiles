-- CUSTOM
require("custom")

hl.on("hyprland.start", function () 
    hl.exec_cmd("qs -c overview")
end)

-- inf desktop
 hl.on("hyprland.start", function()
     hl.exec_cmd("python3 ~/scripts/infinite_desktop_core.py 1.6 > /tmp/infinite-desktop.log 2>&1")
end)

--overview
hl.on("hyprland.start", function()
    hl.exec_cmd("hyprpm reload")
end)


--plugin
-- .config/hypr/hyprland.lua
hl.config({
    plugin = {
        scrolloverview = {
            gesture_distance = 300, -- how far is the "max" for the gesture
            scale = 0.5, -- preferred overview scale
            workspace_gap = 150,
            layout = "vertical", -- vertical or horizontal
            wallpaper = 0, -- 0: global only, 1: per-workspace only, 2: both
            blur = false, -- blur only the main overview wallpaper

	input = {
                drag_mode = 0,          -- 0 = left drag windows, middle pans
                                        -- 1 = left pans, middle drags windows
                drag_threshold = 10,
                left_handed = 0,
                scroll_event_delay = 50,
                touchpad_scroll_factor = 1.0,
                scrolling_mode = 2,
	},

            shadow = {
                enabled = false,
                range = 50,
                render_power = 3,
                color = 0xee1a1a1a,
            },
        },
    },
})


--verthori
 hl.animation({ leaf = "workspaces", enabled = true, speed = 3, bezier = "default", style = "slide" }) --slidevert vert slide horizontal 
